# Local development defaults.
#
# Vite loads this file for `npm run dev` only. A production build (`npm run
# build`, which is what Netlify runs) uses mode "production" and never reads it,
# so nothing here can reach a deployment.
#
# It exists so a fresh clone still runs the full workflow with no credentials,
# now that demo mode is opt-in rather than the consequence of an empty variable.
# Contains no secrets and is committed deliberately.

VITE_ENABLE_LOCAL_DEMO=true
VITE_ENABLE_SIMULATOR=true
