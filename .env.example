# =============================================================================
# OpeniWatch environment configuration
# =============================================================================
# Copy to `.env` and fill in. NEVER commit a populated `.env`.
#
# Variables prefixed with VITE_ are inlined into the browser bundle by Vite.
# Everything else is server-side only (Supabase Edge Functions / CI) and must
# never be referenced from `src/`.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (browser-safe)
# -----------------------------------------------------------------------------
# REQUIRED for any deployment. Both are compiled into the JavaScript bundle at
# BUILD time, not read when the page loads — so setting them in a hosting
# dashboard does nothing until the site is rebuilt and redeployed.
#
# If either is missing, OpeniWatch shows a blocking configuration screen and
# refuses to start. It does NOT quietly fall back to demo data: a deployed
# application backed by browser-local records looks completely normal while
# being visible to nobody, which is the most dangerous failure this product
# has. To run locally without a backend, set VITE_ENABLE_LOCAL_DEMO=true below.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Organization display name for the seeded pilot tenant. Configurable because
# the security-services partner may be renamed.
VITE_DEFAULT_ORG_NAME=Openi Security Services

# Enables the development signal simulator. Off unless this is exactly "true".
#
# Three conditions must all hold for the simulator to be reachable:
#   1. the environment is not Production — where it is refused unconditionally,
#      flag or no flag, because it writes signals into the operational database;
#   2. this flag is "true";
#   3. the signed-in role may submit signals (analyst, program administrator).
#
# Demo mode does not grant simulator access by itself.
VITE_ENABLE_SIMULATOR=false

# Permits the browser-local demo provider. Off unless this is exactly "true",
# and IGNORED when VITE_ENVIRONMENT_LABEL is Staging or Production — a deployed
# environment never substitutes demo data for a backend it cannot reach.
#
# `npm run dev` sets this automatically via .env.development, so a fresh clone
# still runs the whole workflow with no credentials.
VITE_ENABLE_LOCAL_DEMO=false

# Environment name, shown as a compact badge in the header. Leave blank to hide.
#
# This is not only cosmetic. "Staging" or "Production" (case-insensitive, and
# "stage"/"prod" are accepted) switch on fail-closed configuration handling:
# missing Supabase variables produce the blocking configuration screen instead
# of demo data. Any other value, or blank, is treated as development.
VITE_ENVIRONMENT_LABEL=

# Mirrors the server-side OPENIWATCH_ENABLE_SMS flag so the interface can
# explain why SMS is off. It does NOT enable sending.
VITE_ENABLE_SMS=false

# Optional: link back to the Spyglass strategic monitoring layer.
# When set, alerts render a "View in Spyglass" deep link.
VITE_SPYGLASS_BASE_URL=

# -----------------------------------------------------------------------------
# Supabase (server-side only — NEVER expose to the browser)
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required by the ingest, dispatcher and escalation Edge
# Functions. Generate with: openssl rand -hex 32
OPENIWATCH_INGEST_SECRET=

# Which program the ingest endpoint writes into. Resolved server-side so a
# caller cannot name its own program.
OPENIWATCH_INGEST_PROGRAM_SLUG=costco-pilot

# Absolute origin of the deployed app. Used to build push deep links.
OPENIWATCH_APP_ORIGIN=

# -----------------------------------------------------------------------------
# Notification providers (all optional in Phase 1)
# -----------------------------------------------------------------------------
# When unset, OpeniWatch uses the in-app provider plus the development
# provider that records simulated deliveries. No credentials required.

# Web push via OneSignal
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
VITE_ONESIGNAL_APP_ID=

# Critical SMS fallback via Twilio.
#
# DISABLED. No Twilio request is attempted in any code path. Setting this to
# "true" opens the gate but still does not send: consent capture, recipient
# verification and opt-out handling are prerequisites. See docs/INTEGRATIONS.md.
OPENIWATCH_ENABLE_SMS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email / Teams / generic webhook delivery (stubs in Phase 1)
OPENIWATCH_EMAIL_FROM=
MICROSOFT_TEAMS_WEBHOOK_URL=
OPENIWATCH_OUTBOUND_WEBHOOK_URL=
OPENIWATCH_OUTBOUND_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Collection connectors (stubbed in Phase 1 — see docs/INTEGRATIONS.md)
# -----------------------------------------------------------------------------
# Zignal / Spyglass. Endpoint paths are NOT fabricated in this codebase; the
# connector needs vendor documentation before it can be completed.
ZIGNAL_API_BASE_URL=
ZIGNAL_API_KEY=

# RSS / news connector: comma-separated feed URLs.
RSS_FEED_URLS=

# Public safety feed connector (agency-provided endpoint).
PUBLIC_SAFETY_FEED_URL=
PUBLIC_SAFETY_FEED_KEY=
